{
	"name": "joebentaylor-2026",
	"version": "2.0.0",
	"private": true,
	"description": "Joe Ben Taylor — 2026 portfolio, built on Tackl 4",
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0"
	},
	"author": "joebentaylor1995",
	"sideEffects": [
		"*.css",
		"src/components/AnimationPlugins/**"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/joebentaylor1995/joebentaylor-2026"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"type-check": "tsc --noEmit",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"serve": "serve ./out",
		"commit": "node .gitmessage.js",
		"postinstall": "husky",
		"test": "echo \"No tests specified\" && exit 0",
		"lighthouse": "lhci autorun",
		"outdated": "bunx npm-check-updates"
	},
	"dependencies": {
		"@datocms/cda-client": "^0.2.10",
		"@gsap/react": "^2.1.2",
		"graphql": "^16.12.0",
		"gsap": "^3.15.0",
		"lenis": "^1.3.25",
		"next": "^16.2.10",
		"prompts": "^2.4.2",
		"react": "^19.2.7",
		"react-datocms": "^7.2.14",
		"react-dom": "^19.2.7",
		"styled-components": "^6.4.3",
		"unicornstudio-react": "^2.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@lhci/cli": "^0.15.1",
		"@netlify/plugin-nextjs": "4",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/addon-links": "^10.4.6",
		"@storybook/addon-onboarding": "^10.4.6",
		"@storybook/addon-themes": "^10.4.6",
		"@storybook/nextjs": "^10.4.6",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"ajv": "^8.20.0",
		"ajv-keywords": "^5.1.0",
		"husky": "^9.1.7",
		"storybook": "^10.4.6",
		"typescript": "6.0.3"
	},
	"husky": {
		"hooks": {
			"pre-commit": "bun run commit"
		}
	}
}
